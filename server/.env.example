# Port for the Express API
PORT=5050
# Port used by `npm run dev` (the Vite proxy points here)
API_PORT=5050
# Secret used to sign JWTs – change this in production
JWT_SECRET=change-me-to-a-long-random-string
# Optional: your own MongoDB (local or Atlas). Leave empty to use the embedded MongoDB in server/.data
MONGO_URI=
# Optional: store uploads on Cloudinary instead of server/uploads
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
